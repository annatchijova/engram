<style>
  .panel-root {
    flex-direction: column;
    width: 55;
    padding-top: 2;
    padding-bottom: 2;
    padding-left: 2.5;
    padding-right: 2.5;
    background-color: #1a1410;
    border-color: #4a3a2a;
    border-width: 0.15;
    border-radius: 0.6;
  }
  .heading {
    font-size: 1.8;
    font-weight: 700;
    color: #f2e8d8;
    margin-bottom: 1;
  }
  .hint {
    font-size: 1;
    color: #a89878;
    margin-bottom: 1.2;
  }
  .actor-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.8;
  }
  .actor-label {
    font-size: 1.2;
    color: #e8dcc8;
  }
  .stage-btn {
    width: 10;
    height: 1.8;
    background-color: #7a5a2a;
    border-radius: 0.3;
    justify-content: center;
    align-items: center;
    color: #f2e8d8;
    font-size: 1;
    cursor: pointer;
  }
  .preview {
    margin-top: 1.5;
    padding-top: 1;
    border-color: #4a3a2a;
    border-width: 0.1;
    flex-direction: column;
  }
  .preview-text {
    font-size: 1.1;
    color: #f2d8a8;
    margin-bottom: 1;
  }
  .commit-row {
    flex-direction: row;
  }
  .commit-btn {
    width: 10;
    height: 1.8;
    background-color: #a53a3a;
    border-radius: 0.3;
    justify-content: center;
    align-items: center;
    color: white;
    font-size: 1;
    cursor: pointer;
    margin-right: 1;
  }
  .cancel-btn {
    width: 10;
    height: 1.8;
    background-color: #3a3f47;
    border-radius: 0.3;
    justify-content: center;
    align-items: center;
    color: #e8e8e8;
    font-size: 1;
    cursor: pointer;
  }
  .result-text {
    margin-top: 1;
    font-size: 1;
    color: #a8d8a8;
  }
</style>
<div class="panel-root" id="containment-root">
  <div class="heading">containment console</div>
  <span class="hint" id="containment-hint">log in to stage a quarantine</span>
  <div class="actor-row">
    <span class="actor-label" id="actor-row-label">pipeline-logs (ACTIVE)</span>
    <button class="stage-btn" id="stage-btn">Stage quarantine</button>
  </div>
  <div class="preview" id="preview-section" style="display: none">
    <span class="preview-text" id="preview-text"></span>
    <div class="commit-row">
      <button class="commit-btn" id="commit-btn">Commit</button>
      <button class="cancel-btn" id="cancel-btn">Cancel</button>
    </div>
    <span class="result-text" id="result-text"></span>
  </div>
</div>

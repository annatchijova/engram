<style>
  .panel-root { flex-direction: column; width: 62; padding-top: 2.4; padding-bottom: 2.4; padding-left: 2.8; padding-right: 2.8; background-color: #0b0d12ff; border-color: #4a4b4f; border-width: 0.1; border-radius: 0.5; }
  .eyebrow { font-size: 1.05; font-weight: 700; color: #b9b5ab; margin-bottom: 0.5; }
  .title { font-size: 2.2; font-weight: 700; color: #EEE9DF; margin-bottom: 0.6; }
  .plain { font-size: 1.4; color: #b9b5ab; margin-bottom: 1; }
  .field { font-size: 1.6; color: #EEE9DF; margin-bottom: 1.1; }
  .hash { font-size: 1.15; color: #8f8c85; margin-bottom: 0.6; }
  .meta { font-size: 1.15; color: #b9b5ab; margin-bottom: 0.6; }
  .chain { font-size: 1.15; color: #b9b5ab; margin-bottom: 0.8; }
  .trace-btn { width: 100%; height: 3.4; background-color: #EEE9DF; border-radius: 0.4; justify-content: center; align-items: center; color: #0b0d12; font-size: 1.5; font-weight: 700; cursor: pointer; margin-bottom: 0.7; }
  .more-btn { width: 100%; height: 2.8; background-color: #1c2029; border-radius: 0.4; justify-content: center; align-items: center; color: #EEE9DF; font-size: 1.25; cursor: pointer; margin-bottom: 0.7; }
  .close { width: 100%; height: 2.8; background-color: #12141b; border-radius: 0.4; justify-content: center; align-items: center; color: #b9b5ab; font-size: 1.25; cursor: pointer; }
  .impact { font-size: 1.25; color: #EEE9DF; margin-top: 0.4; margin-bottom: 0.8; }
</style>
<div class="panel-root" id="detail-root" style="display: none">
  <span class="eyebrow">MEMORY RECORD - read-only</span>
  <span class="title" id="detail-title">memory</span>
  <span class="plain" id="detail-plain">​</span>
  <span class="field" id="detail-content">​</span>
  <button class="trace-btn" id="detail-trace">Trace impact</button>
  <button class="more-btn" id="detail-more">Show full record (hash, confidence, chain)</button>
  <span class="hash" id="detail-hash" style="display: none">​</span>
  <span class="meta" id="detail-confidence" style="display: none">​</span>
  <span class="chain" id="detail-chain" style="display: none">​</span>
  <span class="impact" id="detail-impact">​</span>
  <button class="close" id="detail-close">Close record</button>
</div>

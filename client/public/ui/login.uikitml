<style>
  .panel-root { flex-direction: column; width: 42; padding-top: 1.8; padding-bottom: 1.8; padding-left: 2.2; padding-right: 2.2; background-color: #0a1019f2; border-color: #e0a62b; border-width: 0.12; border-radius: 0.8; }
  .eyebrow { font-size: 0.9; font-weight: 700; color: #e0a62b; margin-bottom: 0.3; }
  .heading { font-size: 1.8; font-weight: 700; color: #f2f6fa; margin-bottom: 1; }
  .field { width: 100%; height: 2.5; background-color: #060a10; border-color: #2a3a4d; border-width: 0.1; border-radius: 0.5; padding-left: 1; padding-right: 1; color: #e8e8e8; font-size: 1.1; margin-bottom: 0.9; }
  .submit-btn { width: 100%; height: 2.8; background-color: #a3741e; border-radius: 1.15; justify-content: center; align-items: center; color: #fff6e0; font-size: 1.1; font-weight: 700; cursor: pointer; margin-top: 0.4; }
  .status { margin-top: 1; font-size: 1; color: #9fb79f; }
</style>
<div class="panel-root" id="login-root" style="display: none">
  <span class="eyebrow">CONTAINMENT CONSOLE</span>
  <span class="heading">Operator login</span>
  <input class="field" id="login-user" type="text" placeholder="username" autocomplete="username" />
  <input class="field" id="login-pass" type="password" placeholder="password" autocomplete="current-password" />
  <button class="submit-btn" id="login-submit">Log in</button>
  <span class="status" id="login-status"></span>
  <span class="status" id="login-hint">juror account: meta / metavr (acts as analyst-omar). Agent Ada (ada) holds fewer grants and is refused by MNEME.</span>
</div>

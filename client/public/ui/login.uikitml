<style>
  .panel-root {
    flex-direction: column;
    width: 42;
    padding-top: 2;
    padding-bottom: 2;
    padding-left: 2.5;
    padding-right: 2.5;
    background-color: #14161a;
    border-color: #3a3f47;
    border-width: 0.15;
    border-radius: 0.6;
  }
  .heading {
    font-size: 1.8;
    font-weight: 700;
    color: #f2f2f2;
    margin-bottom: 1.2;
  }
  .field {
    width: 100%;
    height: 2.4;
    background-color: #0e1013;
    border-color: #3a3f47;
    border-width: 0.1;
    border-radius: 0.3;
    padding-left: 1;
    padding-right: 1;
    color: #e8e8e8;
    font-size: 1.1;
    margin-bottom: 1;
  }
  .submit-btn {
    width: 100%;
    height: 2.2;
    background-color: #3a6ea5;
    border-radius: 0.3;
    justify-content: center;
    align-items: center;
    color: white;
    font-size: 1.1;
    cursor: pointer;
    margin-top: 0.5;
  }
  .status {
    margin-top: 1;
    font-size: 1;
    color: #9fb79f;
  }
</style>
<div class="panel-root" id="login-root">
  <div class="heading">Operator login</div>
  <input class="field" id="login-user" type="text" placeholder="username" autocomplete="username" />
  <input class="field" id="login-pass" type="password" placeholder="password" autocomplete="current-password" />
  <button class="submit-btn" id="login-submit">Log in</button>
  <span class="status" id="login-status"></span>
</div>

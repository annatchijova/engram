<style>
  .panel-root { flex-direction: column; width: 48; padding-top: 2.4; padding-bottom: 2.4; padding-left: 2.8; padding-right: 2.8; background-color: #0b0d12f4; border-color: #D58B58; border-width: 0.1; border-radius: 0.5; }
  .eyebrow { font-size: 1.2; font-weight: 700; color: #D58B58; margin-bottom: 0.5; }
  .heading { font-size: 2.1; font-weight: 700; color: #EEE9DF; margin-bottom: 1; }
  .field { width: 100%; height: 3; background-color: #07080b; border-color: #4a4b4f; border-width: 0.1; border-radius: 0.3; padding-left: 1; padding-right: 1; color: #EEE9DF; font-size: 1.4; margin-bottom: 0.9; }
  .submit-btn { width: 100%; height: 3.4; background-color: #D58B58; border-radius: 0.4; justify-content: center; align-items: center; color: #0b0d12; font-size: 1.5; font-weight: 700; cursor: pointer; margin-bottom: 0.7; }
  .status { margin-top: 0.6; font-size: 1.25; color: #b9b5ab; }
</style>
<div class="panel-root" id="login-root" style="display: none">
  <span class="eyebrow">CONTAINMENT CONSOLE</span>
  <span class="heading">Operator login</span>
  <input class="field" id="login-user" type="text" placeholder="username" autocomplete="username" />
  <input class="field" id="login-pass" type="password" placeholder="password" autocomplete="current-password" />
  <button class="submit-btn" id="login-submit">Log in</button>
  <span class="status" id="login-status">​</span>
  <span class="status" id="login-hint">juror account: meta / metavr (acts as analyst-omar). Agent Ada (ada) holds fewer grants and is refused by MNEME.</span>
</div>

<style>
  .panel-root { flex-direction: column; width: 58; padding-top: 2.4; padding-bottom: 2.4; padding-left: 2.8; padding-right: 2.8; background-color: #0b0d12ff; border-color: #4a4b4f; border-width: 0.1; border-radius: 0.5; }
  .id { font-size: 2.3; font-weight: 700; color: #EEE9DF; margin-bottom: 0.4; }
  .topic { font-size: 1.6; color: #b9b5ab; margin-bottom: 0.8; }
  .excerpt { font-size: 2.1; color: #EEE9DF; }
  .hint { font-size: 1.5; color: #8f8c85; margin-top: 1; }
</style>
<div class="panel-root" id="preview-root" style="display: none">
  <span class="id" id="preview-id">memory</span>
  <span class="topic" id="preview-topic">​</span>
  <span class="excerpt" id="preview-excerpt">​</span>
  <span class="hint">short pinch opens the full record - hold the pinch to lift the plate off the field</span>
</div>

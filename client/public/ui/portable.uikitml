<style>
  .panel-root {
    flex-direction: column;
    width: 60;
    padding-top: 2;
    padding-bottom: 2;
    padding-left: 2.5;
    padding-right: 2.5;
    background-color: #0f1f18;
    border-color: #2a5a3a;
    border-width: 0.15;
    border-radius: 0.6;
  }
  .heading {
    font-size: 1.8;
    font-weight: 700;
    color: #d8ffe8;
    margin-bottom: 1;
  }
  .hint {
    font-size: 1;
    color: #88b898;
    margin-bottom: 1.2;
  }
  .btn-row {
    flex-direction: row;
    margin-bottom: 1;
  }
  .btn {
    height: 1.8;
    padding-left: 1;
    padding-right: 1;
    background-color: #2a6a4a;
    border-radius: 0.3;
    justify-content: center;
    align-items: center;
    color: #e8ffe8;
    font-size: 1;
    cursor: pointer;
    margin-right: 1;
  }
  .btn-disabled {
    height: 1.8;
    padding-left: 1;
    padding-right: 1;
    background-color: #2a3a30;
    border-radius: 0.3;
    justify-content: center;
    align-items: center;
    color: #6a8a78;
    font-size: 1;
  }
  .result {
    font-size: 1;
    color: #b8e8c8;
  }
</style>
<div class="panel-root">
  <div class="heading">portable instrument</div>
  <span class="hint" id="pi-hint">export the field as a sealed bundle, verified by a genuinely independent process</span>
  <div class="btn-row">
    <button class="btn" id="pi-export">Export &amp; Verify Bundle</button>
    <button class="btn-disabled" id="pi-download">Download bundle.json</button>
  </div>
  <span class="result" id="pi-result"></span>
</div>
